{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "make",
      "runtimeArgs": [
        "api"
      ],
      "port": 8000,
      "url": "http://127.0.0.1:8000"
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/web",
        "dev"
      ],
      "port": 3000,
      "url": "http://127.0.0.1:3000"
    }
  ]
}
