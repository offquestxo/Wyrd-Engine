# Copy to .env (make setup does this) and fill in. Never commit .env.
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
YOUTUBE_API_KEY=
COURTLISTENER_TOKEN=
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Gemini via OAuth instead of an API key (see README): set GEMINI_AUTH=oauth after
# `gcloud auth application-default login ...`. Quota project defaults to the ADC one.
GEMINI_AUTH=api_key
GOOGLE_CLOUD_QUOTA_PROJECT=
# SEC requires a descriptive User-Agent with a contact email.
SEC_USER_AGENT="wyrd.exe research your@email.com"
